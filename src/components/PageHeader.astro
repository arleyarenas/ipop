---
// Cabecera reutilizable para las páginas interiores.
interface Props {
  num: string;
  kicker: string;
  title: string;
  intro?: string;
}
const { num, kicker, title, intro } = Astro.props;
---

<section class="page-header">
  <div class="container">
    <p class="kicker mono"><span class="n">{num}</span> / {kicker}</p>
    <h1 set:html={title} />
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>

<style>
  .page-header { padding: 80px 0 24px; }
  .kicker {
    font-size: 0.82rem;
    color: var(--text-faint);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .n { color: var(--accent); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); max-width: 18ch; }
  .intro { font-size: 1.15rem; max-width: 62ch; }
  @media (max-width: 640px) { .page-header { padding: 52px 0 8px; } }
</style>
