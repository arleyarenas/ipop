---
// Menú de navegación. Para añadir o quitar páginas, edita "links"
// (y añade su glifo en src/data/glifs.js, en la misma posición).
import { perfil } from '../data/perfil.js';
import { svgGlif } from '../data/glifs.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: '/', label: 'Inici', num: '01' },
  { href: '/curriculum', label: 'Currículum', num: '02' },
  { href: '/especialitzacio', label: 'Especialització', num: '03' },
  { href: '/pla-formacio', label: 'Pla de formació', num: '04' },
  { href: '/contacte', label: 'Contacte', num: '05' },
];

const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const currentIdx = Math.max(0, links.findIndex((l) => isActive(l.href)));

// Columna mini del logo: se pinta al revés (el glifo 0 queda abajo)
const N = links.length;
const miniCells = links.map((_, i) => svgGlif(i)).reverse();
---

<header class="nav">
  <div class="container nav-inner">
    <a href={`${base}/`} class="brand" aria-label="Inici">
      <span class="mini-reel" data-mini-reel data-current={currentIdx} data-n={N} aria-hidden="true">
        <span class="mcol" style={`transform: translateY(${-((N - 1 - currentIdx) / N) * 100}%)`}>
          {miniCells.map((svg) => <span class="mcell" set:html={svg} />)}
        </span>
      </span>
      <span class="brand-text">
        <strong>{perfil.nomCurt}</strong>
        <span class="mono">~/ipop</span>
      </span>
    </a>

    <button class="menu-btn" aria-label="Obrir menú" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span>
    </button>

    <nav id="nav-links" class="links" data-links>
      {links.map((l, i) => (
        <a
          href={`${base}${l.href}`}
          class:list={['link', { active: isActive(l.href) }]}
          data-i={i}
          aria-current={isActive(l.href) ? 'page' : undefined}
        >
          <span class="lglyph" set:html={svgGlif(i)} />
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    // Menú móvil y fondo al hacer scroll
    const btn = document.querySelector('.menu-btn');
    const nav = document.querySelector('.nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 10);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ⬡ Columna mini de glifos junto al logo
    const reel = document.querySelector('[data-mini-reel]');
    if (!reel) return;
    const col = reel.querySelector('.mcol');
    const N = Number(reel.dataset.n);
    const cur = Number(reel.dataset.current);
    const DUR = 700;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let shown = cur;
    let timer;

    const place = (i, instant) => {
      if (instant) col.style.transition = 'none';
      col.style.transform = `translateY(${-((N - 1 - i) / N) * 100}%)`;
      if (instant) {
        col.offsetHeight;
        col.style.transition = '';
      }
    };

    const roll = (i) => {
      if (i === shown) return;
      shown = i;
      if (reduce) return place(i, true);
      clearTimeout(timer);
      reel.classList.remove('arrive');
      reel.classList.add('moving');
      place(i);
      timer = setTimeout(() => {
        reel.classList.remove('moving');
        void reel.offsetWidth;
        reel.classList.add('arrive');
        setTimeout(() => reel.classList.remove('arrive'), 600);
      }, DUR);
    };

    // Al entrar: empieza en el glifo de la página anterior y rueda al actual
    let prev = null;
    try {
      prev = sessionStorage.getItem('ipop-glif');
      sessionStorage.setItem('ipop-glif', String(cur));
    } catch (e) {}
    if (prev !== null && Number(prev) !== cur && !reduce) {
      shown = Number(prev);
      place(shown, true);
      setTimeout(() => roll(cur), 150);
    }

    // Al pasar el ratón por un enlace, la columna muestra su glifo
    const links = document.querySelector('[data-links]');
    links.querySelectorAll('.link').forEach((a) => {
      const i = Number(a.dataset.i);
      a.addEventListener('mouseenter', () => roll(i));
      a.addEventListener('focus', () => roll(i));
    });
    links.addEventListener('mouseleave', () => roll(cur));
    links.addEventListener('focusout', (e) => {
      if (!links.contains(e.relatedTarget)) roll(cur);
    });
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .nav.scrolled,
  .nav.open {
    background: rgba(var(--bg-rgb), 0.78);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
  }
  .brand:hover { color: var(--text); }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong { font-family: var(--font-display); }
  .brand-text .mono { font-size: 0.72rem; color: var(--text-faint); }

  /* ---------- Columna mini de glifos ---------- */
  .mini-reel {
    --h: 42px;
    width: 42px;
    height: var(--h);
    overflow: hidden;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    background: rgba(var(--accent-rgb), 0.06);
    box-shadow: 0 0 14px -4px rgba(var(--accent-rgb), 0.6);
  }
  .mcol {
    display: flex;
    flex-direction: column;
    transition: transform 700ms cubic-bezier(0.75, 0, 0.2, 1);
    will-change: transform;
  }
  .mcell {
    height: var(--h);
    flex: none;
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .mcell :global(svg),
  .lglyph :global(svg) {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mcell :global(svg) {
    width: 30px;
    height: 30px;
    stroke-width: 5;
    filter: drop-shadow(0 0 4px rgba(var(--accent-rgb), 0.6));
  }
  .mini-reel.moving .mcell { animation: mflicker 700ms steps(1) both; }
  .mini-reel.arrive .mcell { animation: marrive 600ms ease-out both; }
  @keyframes mflicker {
    0% { opacity: 1; } 10% { opacity: 0.25; } 20% { opacity: 1; } 35% { opacity: 0.5; }
    50% { opacity: 1; } 70% { opacity: 0.4; } 85% { opacity: 1; }
  }
  @keyframes marrive {
    0% { color: var(--accent-2); transform: scale(1.15); filter: brightness(2); }
    100% { transform: scale(1); filter: none; }
  }

  /* ---------- Enlaces ---------- */
  .links {
    display: flex;
    gap: 4px;
  }
  .link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.2s, background 0.2s;
  }
  .lglyph {
    display: grid;
    place-items: center;
    color: var(--text-faint);
    transition: color 0.2s, filter 0.2s;
  }
  .lglyph :global(svg) { width: 18px; height: 18px; stroke-width: 6; }
  .link:hover { color: var(--text); background: var(--surface-2); }
  .link:hover .lglyph { color: var(--accent); }
  .link.active {
    color: var(--text);
    background: rgba(var(--accent-rgb), 0.12);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.35);
  }
  .link.active .lglyph {
    color: var(--accent);
    filter: drop-shadow(0 0 4px rgba(var(--accent-rgb), 0.8));
  }

  .menu-btn {
    display: none;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    cursor: pointer;
    position: relative;
  }
  .menu-btn span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.25s, top 0.25s;
  }
  .menu-btn span:first-child { top: 16px; }
  .menu-btn span:last-child { top: 24px; }
  .nav.open .menu-btn span:first-child { top: 20px; transform: rotate(45deg); }
  .nav.open .menu-btn span:last-child { top: 20px; transform: rotate(-45deg); }

  @media (max-width: 960px) {
    .menu-btn { display: block; }
    .links {
      position: absolute;
      top: var(--nav-h);
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 12px 16px 20px;
      background: rgba(var(--bg-rgb), 0.96);
      border-bottom: 1px solid var(--border);
      display: none;
    }
    .nav.open .links { display: flex; }
    .link { padding: 12px 14px; }
    .lglyph :global(svg) { width: 22px; height: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mcol { transition: none; }
    .mini-reel.moving .mcell, .mini-reel.arrive .mcell { animation: none; }
  }
</style>
