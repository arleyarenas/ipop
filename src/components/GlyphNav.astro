---
import { svgGlif } from '../data/glifs.js';
// ⬡ NAVEGADOR DE GLIFOS
// Basado en tu animación "Glifo Ascendente": al elegir un apartado,
// la columna se desliza hasta su glifo, parpadea y brilla al llegar.
// Si el apartado está más abajo en la lista, el glifo entra desde abajo.
interface Item {
  num: string;
  href: string;
  titol: string;
  desc: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Mismos glifos que el menú: el apartado "02" usa el glifo de la página 2, etc.
const cells = items.map((it) => svgGlif(Number(it.num) - 1));
// Se pintan al revés: el primero queda abajo de la columna
const reversed = [...cells].reverse();
const N = items.length;
const first = items[0];
---

<div class="gnav" data-gnav data-n={N}>
  <div class="g-stage">
    <div class="reel" data-reel>
      <div class="col" style={`transform: translateY(${-((N - 1) / N) * 100}%)`}>
        {reversed.map((svg) => <div class="cell" set:html={svg} />)}
      </div>
    </div>
    <p class="dir mono" data-dir>&nbsp;</p>
  </div>

  <div class="panel">
    <ul class="list" role="list">
      {items.map((it, i) => (
        <li>
          <button
            type="button"
            data-i={i}
            data-titol={it.titol}
            data-desc={it.desc}
            data-href={`${base}${it.href}`}
            aria-current={i === 0 ? 'true' : 'false'}
          >
            <span class="n mono">/{it.num}</span>
            {it.titol}
          </button>
        </li>
      ))}
    </ul>

    <div class="detail" data-detail>
      <h3 data-out-title>{first.titol}</h3>
      <p data-out-desc>{first.desc}</p>
      <a class="btn btn-primary" data-go href={`${base}${first.href}`}>Obrir apartat →</a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gnav]').forEach((nav) => {
    const N = Number(nav.dataset.n);
    const reel = nav.querySelector<HTMLElement>('[data-reel]')!;
    const col = reel.querySelector<HTMLElement>('.col')!;
    const dir = nav.querySelector<HTMLElement>('[data-dir]')!;
    const detail = nav.querySelector<HTMLElement>('[data-detail]')!;
    const title = nav.querySelector<HTMLElement>('[data-out-title]')!;
    const desc = nav.querySelector<HTMLElement>('[data-out-desc]')!;
    const go = nav.querySelector<HTMLAnchorElement>('[data-go]')!;
    const buttons = [...nav.querySelectorAll<HTMLButtonElement>('.list button')];
    const DUR = 900;
    let cur = 0;
    let timer: number | undefined;

    const place = (i: number) => {
      col.style.transform = `translateY(${-((N - 1 - i) / N) * 100}%)`;
    };

    const select = (i: number) => {
      i = Math.max(0, Math.min(N - 1, i));
      if (i === cur) return;
      const goingDown = i > cur; // más abajo en la lista
      cur = i;

      // Movimiento de la columna con parpadeo y brillo al llegar
      clearTimeout(timer);
      reel.classList.remove('arrive');
      reel.classList.add('moving');
      place(i);
      timer = window.setTimeout(() => {
        reel.classList.remove('moving');
        void reel.offsetWidth;
        reel.classList.add('arrive');
        window.setTimeout(() => reel.classList.remove('arrive'), 700);
      }, DUR);

      dir.textContent = goingDown ? '▼ baixa' : '▲ puja';

      // Actualiza la lista y el texto
      buttons.forEach((b, j) => b.setAttribute('aria-current', String(j === i)));
      const b = buttons[i];
      title.textContent = b.dataset.titol ?? '';
      desc.textContent = b.dataset.desc ?? '';
      go.href = b.dataset.href ?? '#';
      detail.classList.remove('flick');
      void detail.offsetWidth;
      detail.classList.add('flick');
    };

    buttons.forEach((b, i) => {
      b.addEventListener('click', () => select(i));
      b.addEventListener('dblclick', () => (location.href = b.dataset.href ?? '#'));
    });

    // Flechas ↑ ↓ cuando el foco está dentro del navegador
    nav.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        select(cur + 1);
        buttons[cur].focus();
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        select(cur - 1);
        buttons[cur].focus();
      }
    });
  });
</script>

<style>
  .gnav {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 32px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: rgba(var(--bg-rgb), 0.7);
    position: relative;
    overflow: hidden;
  }
  .gnav::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 3px);
  }

  /* ---------- Columna de glifos ---------- */
  .g-stage { display: grid; justify-items: center; gap: 10px; }
  .reel {
    --h: 140px;
    width: 140px;
    height: calc(var(--h) * 1.9);
    overflow: hidden;
    -webkit-mask: linear-gradient(transparent, #000 22%, #000 78%, transparent);
    mask: linear-gradient(transparent, #000 22%, #000 78%, transparent);
  }
  .col {
    display: flex;
    flex-direction: column;
    margin-top: calc(var(--h) * 0.45);
    transition: transform 900ms cubic-bezier(0.75, 0, 0.2, 1);
    will-change: transform;
  }
  .cell {
    height: var(--h);
    flex: none;
    display: grid;
    place-items: center;
    color: var(--accent);
  }
  .cell :global(svg) {
    width: 100px;
    height: 100px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px rgba(var(--accent-rgb), 0.45));
  }
  .reel.moving .cell { animation: flicker 900ms steps(1) both; }
  .reel.arrive .cell { animation: arrive 700ms ease-out both; }
  @keyframes flicker {
    0% { opacity: 1; } 8% { opacity: 0.25; } 14% { opacity: 1; } 22% { opacity: 0.5; }
    30% { opacity: 1; } 55% { opacity: 0.7; } 62% { opacity: 1; } 80% { opacity: 0.4; } 86% { opacity: 1; }
  }
  @keyframes arrive {
    0% { filter: brightness(2.2); transform: scale(1.12); color: var(--accent-2); }
    35% { filter: drop-shadow(0 0 14px var(--accent-2)) brightness(1.4); }
    100% { filter: none; transform: scale(1); }
  }
  .dir { margin: 0; font-size: 0.75rem; color: var(--amber); letter-spacing: 0.12em; text-transform: uppercase; }

  /* ---------- Lista y detalle ---------- */
  .panel { display: grid; gap: 22px; min-width: 0; position: relative; z-index: 1; }
  .list { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .list button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-dim);
    font: inherit;
    font-size: 0.95rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .list button:hover { color: var(--text); border-color: var(--border-strong); }
  .list button[aria-current='true'] {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 20px -6px rgba(var(--accent-rgb), 0.8);
  }
  .n { font-size: 0.75rem; opacity: 0.75; width: 3.5ch; }

  .detail {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .detail h3 { margin-bottom: 6px; }
  .detail.flick { animation: flicker 600ms steps(1) both; }

  @media (max-width: 760px) {
    .gnav { grid-template-columns: 1fr; padding: 24px 18px; gap: 20px; }
    .reel { --h: 110px; width: 110px; height: calc(var(--h) * 1.4); }
    .col { margin-top: calc(var(--h) * 0.2); }
    .cell :global(svg) { width: 78px; height: 78px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .col { transition: none; }
    .reel.moving .cell, .reel.arrive .cell, .detail.flick { animation: none; }
  }
</style>
