---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { fullDeRuta, certificacions, projecte } from '../data/perfil.js';

const estats = {
  'en-curs': { text: 'En curs', cls: 'curs' },
  pendent: { text: 'Pendent', cls: 'pend' },
  fet: { text: 'Fet', cls: 'fet' },
};
---

<Layout title="Pla de formació">
  <PageHeader
    num="04"
    kicker="Pla de formació i projecte professional"
    title={`El meu <span class="gradient-text">full de ruta</span>`}
    intro="Els passos que penso seguir per especialitzar-me: titulacions, certificacions, pràctiques i el projecte que estic construint."
  />

  <!-- Full de ruta -->
  <section class="section">
    <div class="container">
      <SectionTitle title="Full de ruta" />
      <ol class="road">
        {fullDeRuta.map((f) => {
          const st = estats[f.estat] ?? estats.pendent;
          return (
            <li class="reveal">
              <span class:list={['node', st.cls]}></span>
              <div class="card road-card">
                <div class="road-head">
                  <span class="mono when">{f.quan}</span>
                  <span class:list={['pill', st.cls]}>{st.text}</span>
                </div>
                <h3>{f.titol}</h3>
                <p>{f.desc}</p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- Certificacions -->
  <section class="section">
    <div class="container">
      <SectionTitle title="Certificacions previstes" sub="Formació complementària al títol per accedir als llocs de treball objectiu." />
      <div class="grid grid-4">
        {certificacions.map((c) => (
          <div class="card lift cert reveal">
            <span class="mono prio">Prioritat {c.prioritat.toLowerCase()}</span>
            <h3>{c.nom}</h3>
            <p>{c.entitat}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Projecte propi -->
  <section class="section">
    <div class="container">
      <SectionTitle title="Projecte professional propi" />
      <div class="project reveal">
        <div class="project-main">
          <span class="pill curs">En desenvolupament</span>
          <h2>♻️ {projecte.nom}</h2>
          <p class="lema">{projecte.lema}</p>
          <p>{projecte.desc}</p>
          <div class="tags">
            {projecte.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
          {projecte.repo && (
            <div class="btn-row" style="margin-top:24px">
              <a href={projecte.repo} class="btn btn-primary" target="_blank" rel="noopener">Veure el repositori ↗</a>
            </div>
          )}
        </div>
        <ul class="features">
          {projecte.funcions.map((f) => (
            <li><span>{f.icona}</span>{f.text}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .road { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 18px; }
  .road::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--accent-2), transparent);
  }
  .road li { position: relative; padding-left: 44px; }
  .node {
    position: absolute;
    left: 0;
    top: 26px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg);
    border: 3px solid var(--text-faint);
  }
  .node.curs { border-color: var(--amber); box-shadow: 0 0 14px rgba(var(--amber-rgb), 0.5); }
  .node.fet { border-color: var(--green); background: var(--green); }
  .road-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
  .when { font-size: 0.82rem; color: var(--accent-2); }
  .road-card h3 { margin-bottom: 4px; }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
    white-space: nowrap;
  }
  .pill.curs { color: var(--amber); border-color: rgba(var(--amber-rgb), 0.4); background: rgba(var(--amber-rgb), 0.08); }
  .pill.fet { color: var(--green); border-color: rgba(var(--green-rgb), 0.4); background: rgba(var(--green-rgb), 0.08); }

  .cert { border-top: 3px solid var(--accent); }
  .prio { font-size: 0.75rem; color: var(--accent-2); }
  .cert h3 { margin-top: 10px; }

  .project {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    padding: 44px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(var(--green-rgb), 0.3);
    background:
      radial-gradient(60% 100% at 0% 0%, rgba(var(--green-rgb), 0.12), transparent 70%),
      radial-gradient(60% 100% at 100% 100%, rgba(var(--accent-rgb), 0.12), transparent 70%),
      var(--bg-2);
  }
  .project h2 { margin: 16px 0 4px; }
  .lema { color: var(--accent-2); font-weight: 500; }
  .features { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; align-content: center; }
  .features li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border-radius: var(--radius-sm);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 500;
  }
  .features span { font-size: 1.3rem; }

  @media (max-width: 860px) {
    .project { grid-template-columns: 1fr; padding: 28px 22px; }
  }
</style>
