---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { perfil } from '../data/perfil.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const canals = [
  { nom: 'Correu electrònic', valor: perfil.email, url: perfil.email ? `mailto:${perfil.email}` : '', icona: '✉️' },
  { nom: 'LinkedIn', valor: 'Perfil professional', url: perfil.linkedin, icona: '💼' },
  { nom: 'GitHub', valor: 'Projectes i codi', url: perfil.github, icona: '🐙' },
  { nom: 'Telegram', valor: perfil.telegram, url: perfil.telegram ? `https://t.me/${perfil.telegram.replace('@', '')}` : '', icona: '💬' },
].filter((c) => c.url);
---

<Layout title="Contacte">
  <PageHeader
    num="05"
    kicker="Contacte"
    title={`Parlem? <span class="gradient-text">Connectem</span>`}
    intro="Busco pràctiques o una primera oportunitat en sistemes i xarxes. Si creus que puc encaixar al teu equip, escriu-me."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="grid channels">
        {canals.map((c) => (
          <a href={c.url} class="card lift channel reveal" target={c.url.startsWith('mailto') ? undefined : '_blank'} rel="noopener">
            <span class="icon">{c.icona}</span>
            <div>
              <h3>{c.nom}</h3>
              <p class="mono">{c.valor}</p>
            </div>
            <span class="arrow">↗</span>
          </a>
        ))}
      </div>

      <aside class="cv reveal">
        <p class="mono label">curriculum.pdf</p>
        <h2>El meu CV</h2>
        <p>Versió descarregable i actualitzada del meu currículum.</p>
        <a href={`${base}/${perfil.cvPdf}`} class="btn btn-primary" download>Descarregar CV ↓</a>
        <p class="loc mono">📍 {perfil.ubicacio}</p>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 28px;
    align-items: start;
  }
  .channels { grid-template-columns: 1fr; gap: 14px; }
  .channel {
    display: flex;
    align-items: center;
    gap: 18px;
    color: inherit;
    padding: 22px 24px;
  }
  .channel:hover { color: inherit; }
  .channel .icon { margin: 0; flex-shrink: 0; }
  .channel h3 { margin: 0 0 2px; }
  .channel p { margin: 0; font-size: 0.85rem; word-break: break-all; }
  .channel > div { flex-grow: 1; min-width: 0; }
  .arrow { color: var(--text-faint); font-size: 1.2rem; transition: color 0.2s, transform 0.2s; }
  .channel:hover .arrow { color: var(--accent); transform: translate(3px, -3px); }

  .cv {
    position: sticky;
    top: calc(var(--nav-h) + 20px);
    padding: 36px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    background:
      radial-gradient(80% 80% at 100% 0%, rgba(var(--accent-2-rgb), 0.14), transparent 70%),
      var(--bg-2);
  }
  .label { color: var(--accent-2); font-size: 0.82rem; }
  .loc { margin: 24px 0 0; font-size: 0.85rem; color: var(--text-faint); }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
    .cv { position: static; padding: 28px 22px; }
  }
</style>
